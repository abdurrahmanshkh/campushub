# MongoDB connection URI (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=build60

# Secure Auth Secret for JWT sessions (min 32 characters)
AUTH_SECRET=build60_campus_growth_hub_jwt_secret_token_secure_2025

# Site URL for canonical URLs, Open Graph images and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default Initial Admin Credentials (seeded on first run)
